# TLS certificates are obtained and renewed automatically.
# SITE_ADDRESS is the public host name, for example "watch.example.org".

{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode gzip

	handle {
		reverse_proxy app:8000 {
			# Replace, never append: the app trusts the last entry of this header.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# The application sets its own security headers. These two belong to the proxy.
	header {
		-Server
		-Via
	}

	request_body {
		max_size 2MB
	}

	log {
		output stdout
		# The address of a sign-in link contains a one-time token. The token is
		# kept out of the log.
		format filter {
			wrap json
			fields {
				request>uri regexp "^/auth/[^/?]+" "/auth/[removed]"
			}
		}
	}
}
