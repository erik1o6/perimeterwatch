# Copy to deploy/.env, fill in, then: chmod 600 deploy/.env
# Never commit the filled-in file. See deploy/env.reference.md for every setting.

# --- required ---------------------------------------------------------------
SITE_ADDRESS=watch.example.org
ACME_EMAIL=admin@example.org
PARAPET_BASE_URL=https://watch.example.org

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate with: docker run --rm parapet:local db new-key
# To rotate, put the new key first and keep the old one after a comma.
PARAPET_DATA_KEYS=

# Shown to the operators of hosts that receive scan traffic.
PARAPET_CONTACT_URL=https://watch.example.org/about
PARAPET_ABUSE_EMAIL=abuse@example.org

# Sign-in links and email alerts
PARAPET_SMTP_HOST=
PARAPET_SMTP_PORT=587
PARAPET_SMTP_USER=
PARAPET_SMTP_PASSWORD=
PARAPET_MAIL_FROM=Parapet <no-reply@example.org>

# --- optional ---------------------------------------------------------------
# Read-only token, public data only. Needed for secret scanning.
GITHUB_TOKEN=
# Needed for Safe multisig checks.
PARAPET_RPC_ETH_MAINNET=
# Needed for breach lookups. See docs/operations.md on whose key this should be.
HIBP_API_KEY=
# More subdomain sources
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
CERTSPOTTER_API_KEY=
CHAOS_API_KEY=

# PARAPET_SIGNUP_OPEN=false
# PARAPET_RETENTION_DAYS=90
# PARAPET_MAX_TARGETS_PER_TENANT=10
# PARAPET_MIN_SCAN_INTERVAL_MINUTES=360
# PARAPET_NEVER_CONTACT=["198.51.100.0/24","host.example.net"]
