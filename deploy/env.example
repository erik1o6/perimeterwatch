# Copy to deploy/.env, fill in, then: chmod 600 deploy/.env
# Never commit the filled-in file. See deploy/env.reference.md for every setting.

# --- required ---------------------------------------------------------------
SITE_ADDRESS=watch.example.org
ACME_EMAIL=admin@example.org
PW_BASE_URL=https://watch.example.org

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate with: docker run --rm perimeterwatch:local db new-key
# To rotate, put the new key first and keep the old one after a comma.
PW_DATA_KEYS=

# Shown to the operators of hosts that receive scan traffic.
PW_CONTACT_URL=https://watch.example.org/about
PW_ABUSE_EMAIL=abuse@example.org
# Where to report a vulnerability in the service. Answers /.well-known/security.txt.
PW_SECURITY_EMAIL=security@example.org
# A general contact, shown on the public pages.
PW_CONTACT_EMAIL=hello@example.org
# The addresses scans leave from, shown on the public page.
# PW_SCAN_SOURCES=["203.0.113.10"]

# Sign-in links and email alerts
PW_SMTP_HOST=
PW_SMTP_PORT=587
PW_SMTP_USER=
PW_SMTP_PASSWORD=
PW_MAIL_FROM=Perimeterwatch <no-reply@example.org>

# --- optional ---------------------------------------------------------------
# Read-only token, public data only. Needed for secret scanning.
GITHUB_TOKEN=
# Needed for Safe multisig checks.
PW_RPC_ETH_MAINNET=
# Needed for breach lookups. See docs/operations.md on whose key this should be.
HIBP_API_KEY=
# More subdomain sources
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
CERTSPOTTER_API_KEY=
CHAOS_API_KEY=

# PW_SIGNUP_OPEN=false
# PW_RETENTION_DAYS=90
# PW_MAX_TARGETS_PER_TENANT=10
# PW_MIN_SCAN_INTERVAL_MINUTES=360
# PW_NEVER_CONTACT=["198.51.100.0/24","host.example.net"]
