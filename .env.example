# Copy to .env, fill in what you have, then: chmod 600 .env
# Everything here is optional. `pwatch doctor` shows what each key enables.

# Read-only GitHub token, public data only. Enables secret scanning and raises rate limits.
GITHUB_TOKEN=

# Have I Been Pwned key. Breach lookups run only for a domain you have verified.
HIBP_API_KEY=

# Ethereum RPC address, for reading Safe owners. Treated as a secret: it usually holds a key.
PW_RPC_ETH_MAINNET=

# More sources for subdomain discovery
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
CERTSPOTTER_API_KEY=
CHAOS_API_KEY=

# Shown to the operators of hosts you scan, so they can reach you.
# PW_CONTACT_URL=https://yourproject.xyz/security
# PW_ABUSE_EMAIL=security@yourproject.xyz
